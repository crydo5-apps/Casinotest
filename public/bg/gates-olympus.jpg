<svg xmlns="http://www.w3.org/2000/svg" width="400" height="300" viewBox="0 0 400 300">
  <defs>
    <radialGradient id="bg" cx="50%" cy="30%">
      <stop offset="0%" stop-color="#1a1040"/>
      <stop offset="100%" stop-color="#0a0604"/>
    </radialGradient>
    <radialGradient id="glow" cx="50%" cy="40%">
      <stop offset="0%" stop-color="#c9a227" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#c9a227" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffd700"/>
      <stop offset="50%" stop-color="#c9a227"/>
      <stop offset="100%" stop-color="#8a6a20"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#bg)"/>
  <circle cx="200" cy="120" r="150" fill="url(#glow)"/>
  <path d="M170 200 L200 80 L230 200 Z" fill="none" stroke="url(#gold)" stroke-width="2" opacity="0.6"/>
  <path d="M150 200 L200 60 L250 200 Z" fill="none" stroke="url(#gold)" stroke-width="1" opacity="0.3"/>
  <circle cx="200" cy="130" r="30" fill="none" stroke="#ffd700" stroke-width="1.5" opacity="0.5"/>
  <text x="200" y="250" text-anchor="middle" font-family="serif" font-size="18" fill="#c9a227" opacity="0.8">GATES OF OLYMPUS</text>
  <text x="200" y="275" text-anchor="middle" font-family="serif" font-size="12" fill="#ffd700" opacity="0.6">1000</text>
</svg>
